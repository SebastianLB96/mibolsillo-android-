<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_fila"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/viewMiniatura"
        android:layout_width="44dp"
        android:layout_height="36dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/desc_comprobante"
            android:src="@drawable/ic_fotos"
            android:tint="@color/blanco" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDescripcionGasto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gris_oscuro"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResumenGasto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gris_texto"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtValorGasto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/verde_oscuro"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
