<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_botones"
            android:textColor="@color/gris_oscuro"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRegistrarGasto"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_boton_verde"
            android:text="@string/btn_registrar"
            android:textColor="@color/blanco"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVerGrafico"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_boton_verde_oscuro"
            android:text="@string/btn_grafico"
            android:textColor="@color/blanco"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDefinirPresupuesto"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_boton_azul"
            android:text="@string/btn_presupuesto"
            android:textColor="@color/blanco"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEscanearFactura"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_boton_borde"
            android:text="@string/btn_escanear"
            android:textColor="@color/gris_texto"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resultado_titulo"
                android:textColor="@color/verde_oscuro"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtResultadoAccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/resultado_inicial"
                android:textColor="@color/gris_texto"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_gris"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grafico_titulo"
                android:textColor="@color/gris_oscuro"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/barraAlimentacion"
                        android:layout_width="22dp"
                        android:layout_height="62dp"
                        android:background="@color/verde_primario" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/cat_alimentacion"
                        android:textColor="@color/gris_texto"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/barraTransporte"
                        android:layout_width="22dp"
                        android:layout_height="40dp"
                        android:background="@color/verde_oscuro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/cat_transporte"
                        android:textColor="@color/gris_texto"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/barraHogar"
                        android:layout_width="22dp"
                        android:layout_height="78dp"
                        android:background="@color/azul" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/cat_hogar"
                        android:textColor="@color/gris_texto"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/barraOcio"
                        android:layout_width="22dp"
                        android:layout_height="30dp"
                        android:background="@color/ambar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/cat_ocio"
                        android:textColor="@color/gris_texto"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|bottom"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/barraSalud"
                        android:layout_width="22dp"
                        android:layout_height="52dp"
                        android:background="@color/rojo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/cat_salud"
                        android:textColor="@color/gris_texto"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
